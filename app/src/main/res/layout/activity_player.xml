<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:id="@+id/activity_player">

    <!-- ExoPlayer View -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:resize_mode="fit" />

    <!-- Top Bar with Aspect Ratio Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp"
        android:background="#33000000">

        <!-- Attractive Aspect Ratio Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aspect_ratio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="Fit"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_aspect_ratio"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white"
            app:iconSize="18dp"
            android:elevation="4dp"
            android:tooltipText="Change video display mode" />

    </LinearLayout>

    <!-- Control Buttons Container -->
    <LinearLayout
        android:id="@+id/controlButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80000000"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/teal_700"
            android:layout_margin="8dp"
            android:padding="12dp"
            android:minWidth="100dp"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_dark"
            android:layout_margin="8dp"
            android:padding="12dp"
            android:minWidth="100dp"/>

    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_channels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="Open Channels"
        android:src="@drawable/add"
        app:backgroundTint="@color/teal_700"
        app:tint="@android:color/white"
        app:rippleColor="@color/teal_200"
        app:fabSize="normal"
        app:tooltipText="Open Channels" />

</FrameLayout>