<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/activity_player"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ExoPlayer View - Full Screen with Multiple Resize Options -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:resize_mode="zoom" />  <!-- ← CHANGE THIS VALUE for different effects -->

    <!-- Control Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80000000"
        android:visibility="gone"
        android:id="@+id/controlButtonsContainer">

        <Button
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/teal_700"
            android:layout_margin="8dp"
            android:padding="12dp"
            android:minWidth="100dp"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_dark"
            android:layout_margin="8dp"
            android:padding="12dp"
            android:minWidth="100dp"/>

    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_channels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="Open Channels"
        app:backgroundTint="@color/teal_700"
        app:tint="@android:color/white"
        app:rippleColor="@color/teal_200"
        app:fabSize="normal"
        app:tooltipText="Open Channels" />

</FrameLayout>